MESHTASTIC_HOST=192.168.x.x
MESHTASTIC_PORT=4403
RECONNECT_INTERVAL=15
STALE_MINUTES=15
DATABASE_URL=sqlite:///data/meshtastic.db
API_KEY=
PRUNE_DAYS=30
GEOFENCE_WEBHOOK_URL=
# Comma separated hostnames that are allowed to receive geofence webhooks (defense-in-depth)
GEOFENCE_WEBHOOK_ALLOWED_HOSTS=
# Rate limiting
RATE_LIMIT=20
RATE_WINDOW_SECONDS=60
# API safety caps
MAX_MESSAGES_LIMIT=500
MAX_POSITIONS_HOURS=720
MAX_TRAIL_POSITIONS=2000
# CORS (optional, comma separated origins). Leave empty for same-origin only.
CORS_ALLOW_ORIGINS=
# Logging
LOG_LEVEL=INFO
